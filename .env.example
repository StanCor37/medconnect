# Postgres connection string (Neon or any Postgres 14+ instance).
# Single owner-level connection for this phase — see README for the
# pre-production TODO on adding a restricted non-owner app role for RLS.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Secret used to encrypt the session cookie (iron-session). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-32-byte-random-hex-string"

NODE_ENV="development"

# Root directory for locally-stored Document originals (Segment 5). Defaults
# to ./storage/documents if unset. Never encrypted at rest this phase — see
# README's "Known limitations" for the pre-production TODO.
# DOCUMENT_STORAGE_ROOT="./storage/documents"

# Segment 7 — required for AI-assisted Validation Rule execution (real Claude
# API calls via @anthropic-ai/sdk). Get a key at https://console.anthropic.com/ —
# set this yourself, it is never handled by the assistant.
ANTHROPIC_API_KEY="replace-with-your-key"
# Optional overrides (defaults shown):
# ANTHROPIC_MODEL="claude-sonnet-5"
# AI_RULE_CALL_BUDGET="5"
# AI_LOW_CONFIDENCE_HITL_THRESHOLD="0.6"
